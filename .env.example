# Supabase — Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser, never commit.
# Used by scripts/seed and admin-side storage operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata / auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — transactional email for the Packages inquiry form (admin
# notification + customer confirmation). Get a key at resend.com.
# Without it, inquiries still save to the database; emails are just skipped.
RESEND_API_KEY=your-resend-api-key

# Optional. Defaults shown below — the resend.dev sender works with no
# domain setup but is rate-limited; switch to a verified sending domain once
# one is set up in the Resend dashboard.
# EMAIL_FROM=Lensaeri Studio <onboarding@resend.dev>
# ADMIN_NOTIFY_EMAIL=lensaeri@gmail.com
